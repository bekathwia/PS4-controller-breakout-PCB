<connect gate="G$1" pin="B2A" pad="B2A"/>
<connect gate="G$1" pin="B2B" pad="B2B"/>
<connect gate="G$1" pin="GND@1" pad="MOUNT1"/>
<connect gate="G$1" pin="GND@2" pad="MOUNT2"/>
<connect gate="G$1" pin="GND@3" pad="MOUNT3"/>
<connect gate="G$1" pin="GND@4" pad="MOUNT4"/>
<connect gate="G$1" pin="H" pad="H2"/>
<connect gate="G$1" pin="H+" pad="H1"/>
<connect gate="G$1" pin="H-" pad="H3"/>
<connect gate="G$1" pin="V" pad="V2"/>
<connect gate="G$1" pin="V+" pad="V1"/>
<connect gate="G$1" pin="V-" pad="V3"/>
</connects>
<package3dinstances>
